# ============================================================
# ENVIRONMENT VARIABLES — Perpustakaan Digital
# Salin file ini menjadi `.env` di root proyek, lalu isi nilai sebenarnya.
# JANGAN PERNAH commit file `.env` — hanya `.env.example` ini yang boleh
# masuk Git. Pastikan `.env` ada di `.gitignore`.
# Lihat rencana-pengembangan/07-aturan-eksekusi-untuk-claude-code.md
# bagian "Keamanan" untuk aturan terkait.
# ============================================================

# ---------------- Server ----------------
PORT=3000
NODE_ENV=development

# ---------------- Firebase Admin SDK (backend, RAHASIA) ----------------
# Ambil dari Firebase Console > Project Settings > Service Accounts >
# Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key mengandung karakter newline. Simpan sebagai satu baris
# dengan \n literal (diapit tanda kutip); backend mengubahnya jadi
# newline asli saat membaca env ini.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# Alternatif (opsional): kalau pakai file service account JSON lokal
# untuk development, isi path berikut dan abaikan tiga variabel
# FIREBASE_* di atas.
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---------------- Firebase Storage ----------------
# Dipakai HANYA untuk sampul buku. PDF tidak disalin massal ke Storage —
# lihat rencana-pengembangan/08-keputusan-yang-sudah-diasumsikan.md poin 2.
FIREBASE_STORAGE_BUCKET=nama-project.appspot.com

# ---------------- Firebase Web config (dipakai frontend) ----------------
# Dari Firebase Console > Project Settings > General > Your apps > Web app.
# Nilai ini TIDAK rahasia (memang terlihat di sisi klien, keamanan diatur
# lewat Firebase Security Rules, bukan dengan menyembunyikan nilai ini).
# Disimpan di env supaya tidak di-hardcode langsung di index.html /
# login.html / admin.html, memudahkan ganti environment (dev/staging/prod).
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=nama-project.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=nama-project
FIREBASE_WEB_STORAGE_BUCKET=nama-project.appspot.com
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# ---------------- Firebase Auth Emulator (dev) ----------------
# WAJIB untuk project yang belum mengaktifkan Firebase Authentication di
# Identity Platform (error CONFIGURATION_NOT_FOUND). Kosongkan di produksi.
# Format: host:port tanpa skema (backend menambahkan skema untuk browser SDK).
#   Admin SDK/backend -> 127.0.0.1:9099
#   Browser SDK       -> http://127.0.0.1:9099  (diberikan otomatis oleh /api/config)
# Jalankan emulator: npm run emulators
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------- Bootstrap admin pertama ----------------
# Daftar email (pisahkan koma) yang otomatis diberi role "admin" SAAT
# profil pertama kali dibuat lewat POST /api/auth/profile. Dipakai untuk
# memecahkan masalah "ayam-telur": endpoint ubah role (PATCH
# /api/admin/users/:id/role) hanya bisa diakses admin, jadi perlu cara
# menentukan admin pertama tanpa lewat endpoint itu. Hanya dipakai saat
# pembuatan profil, tidak bisa dipakai untuk menaikkan role sesudahnya.
ADMIN_BOOTSTRAP_EMAILS=admin@sekolah.sch.id

# ---------------- API sumber katalog (eksternal) ----------------
# Base URL API sumber 760+ buku yang sudah dipakai di index.html asli.
CATALOG_SOURCE_API_BASE=https://api.buku.cloudapp.web.id/api/catalogue/

# Umur cache katalog (ms). Setelah kedaluwarsa, request berikutnya dilayani
# dari cache lama sambil menarik ulang dari API sumber di latar belakang.
CATALOG_CACHE_TTL_MS=21600000

# Umur cache daftar buku yang disembunyikan admin (ms). Katalog terbuka untuk
# umum, jadi daftar ini di-cache agar request anonim tidak kena query
# Firestore. Harus pendek supaya status terbit yang baru diubah admin cepat
# berlaku.
CATALOG_HIDDEN_TTL_MS=15000

# Firestore Emulator (dev opsional). Isi "host:port" tanpa skema kalau mau
# menguji tanpa menyentuh kuota tulis project produksi.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ---------------- Aturan bisnis ----------------
# Lihat rencana-pengembangan/05-spesifikasi-fitur-mvp.md
DOWNLOAD_QUOTA_PER_DAY=3
READING_GATE_MIN_WORDS=40

# ---------------- CORS ----------------
# Hanya relevan jika frontend di-hosting terpisah dari backend Express.
# Kalau public/ disajikan dari server Express yang sama, boleh dikosongkan
# atau disamakan dengan origin server ini.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ---------------- Rate limiting (opsional, lihat Hari 10) ----------------
# Nilai awal yang wajar untuk endpoint sensitif (login, unduhan, submit tugas).
# Boleh disesuaikan saat pengerasan keamanan di Hari 10.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
